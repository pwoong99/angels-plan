rules_version = '2';
// 엔젤스 플랜 (angels-plan 프로젝트) 보안 규칙
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    // 관리자: 관리자 비밀번호를 아는 기기만 teachers에 자기 문서를 만들 수 있어요 (비밀번호는 해시로만 비교)
    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/teachers/$(request.auth.uid));
    }
    // 선생님: 등록 후 관리자가 승인한 이름 + 비밀번호로 만든 입장 기록(tsessions)
    function sess() {
      return get(/databases/$(database)/documents/tsessions/$(request.auth.uid)).data;
    }
    function isTeacher() {
      return signedIn()
        && exists(/databases/$(database)/documents/tsessions/$(request.auth.uid))
        && get(/databases/$(database)/documents/teacherAccounts/$(sess().name)).data.approved == true;
    }

    match /teachers/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['k', 'at'])
        && request.resource.data.k is string
        && hashing.sha256(request.resource.data.k).toHexString().lower() == 'f27f4df9c0ac06cc9008fa8dade0bedbff942573d413bb5c73b86f7ef24bac8a';
    }

    // 앱 전체 설정(날개 단계 기준 점수 등): 누구나 읽고, 관리자만 바꿈
    match /settings/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // 선생님 등록 신청: 누구나 새 이름으로 신청(승인 전 상태로만), 승인·취소·삭제는 관리자만
    match /teacherAccounts/{name} {
      allow read: if signedIn();
      allow create: if signedIn()
        && name.size() >= 1 && name.size() <= 20
        && request.resource.data.keys().hasOnly(['name', 'school', 'approved', 'createdAt'])
        && request.resource.data.name == name
        && request.resource.data.approved == false
        && request.resource.data.school is string && request.resource.data.school.size() <= 30;
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['approved']);
      allow delete: if isAdmin();
    }
    // 비밀번호 확인값(해시의 해시) — 아무도 읽을 수 없어요
    match /teacherSecrets/{name} {
      allow create: if signedIn()
        && !exists(/databases/$(database)/documents/teacherSecrets/$(name))
        && request.resource.data.keys().hasOnly(['kh'])
        && request.resource.data.kh is string && request.resource.data.kh.size() == 64;
      allow delete: if isAdmin();
    }
    // 선생님 입장: 승인된 이름 + 맞는 비밀번호일 때만 자기 기기에 입장 기록을 남겨요
    match /tsessions/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'k', 'at'])
        && request.resource.data.k is string
        && get(/databases/$(database)/documents/teacherAccounts/$(request.resource.data.name)).data.approved == true
        && hashing.sha256(request.resource.data.k).toHexString().lower()
           == get(/databases/$(database)/documents/teacherSecrets/$(request.resource.data.name)).data.kh;
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    // 게임방: 접속한 누구나 보기. 관리자는 모든 방, 선생님은 자기가 만든 방만 만들기·바꾸기·지우기
    match /rooms/{code} {
      allow read: if signedIn();
      allow create: if isAdmin() || (isTeacher() && request.resource.data.owner == sess().name);
      allow update: if isAdmin() || (isTeacher() && resource.data.owner == sess().name && request.resource.data.owner == sess().name);
      allow delete: if isAdmin() || (isTeacher() && resource.data.owner == sess().name);

      function canManage() {
        return isAdmin() || (isTeacher() && get(/databases/$(database)/documents/rooms/$(code)).data.owner == sess().name);
      }

      function room() {
        return get(/databases/$(database)/documents/rooms/$(code)).data;
      }
      function playerUid(name) {
        return get(/databases/$(database)/documents/rooms/$(code)/players/$(name)).data.uid;
      }

      // 학생: 이름으로 입장(같은 이름이면 이어하기), 나만의 천사 캐릭터(av) 저장, 울타리치기 선 저장, 라운드마다 한 번만 제출
      // 점수·결과·팀·대결 배정은 선생님 화면만 쓸 수 있어요
      match /players/{pid} {
        allow read: if signedIn();
        allow delete: if canManage();
        allow create: if canManage() || (
          signedIn()
          && exists(/databases/$(database)/documents/rooms/$(code))
          && pid.size() >= 1 && pid.size() <= 10
          && request.resource.data.keys().hasOnly(['name', 'uid', 'score', 'edges', 'joinedAt', 'lastSeen', 'av'])
          && request.resource.data.name == pid
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.score == 0
          && request.resource.data.edges is string
        );
        allow update: if canManage() || (
          signedIn()
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['uid', 'edges', 'sub', 'lastSeen', 'av'])
          && (!('av' in request.resource.data) || (request.resource.data.av is map && request.resource.data.av.size() <= 10))
          && request.resource.data.edges is string
          && request.resource.data.edges.size() <= 200
          && (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['sub'])
            || (
              request.resource.data.sub.keys().hasOnly(['round', 'edges', 'at'])
              && request.resource.data.sub.at == request.time
              && request.resource.data.sub.edges is string
              && request.resource.data.sub.edges.size() <= 200
              && room().status == 'playing'
              && request.resource.data.sub.round == room().round
              && (!('sub' in resource.data) || resource.data.sub.round != request.resource.data.sub.round)
            )
          )
        );
      }

      // 벽바둑 대결(2~4명): 선생님이 만들고, 그 대결에 들어간 학생만 수를 둘 수 있어요
      match /matches/{mid} {
        allow read: if signedIn();
        allow create, delete: if canManage();
        allow update: if canManage() || (
          signedIn()
          && (playerUid(resource.data.a) == request.auth.uid || playerUid(resource.data.b) == request.auth.uid
              || ('c' in resource.data && playerUid(resource.data.c) == request.auth.uid)
              || ('d' in resource.data && playerUid(resource.data.d) == request.auth.uid))
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['stones', 'walls', 'turn', 'phase', 'placeNo', 'moveNo', 'deadline', 'last', 'scoreA', 'scoreB', 'scores', 'ranks', 'winner', 'endedAt'])
          && resource.data.phase != 'done'
        );
      }
    }
  }
}
